
/*
    ============================================================
              APEXPLANET - SILVER LAYER TABLE CREATION
    ============================================================

    Description:
    This script creates the Silver layer table in the
    ApexPlanet database.

    Database : apexplanet
    Schema   : silver
    Table    : apexplanet_dataanalytics_dataset

    PURPOSE:
    The Silver layer stores cleaned, standardized, and
    validated data received from the Bronze layer.

    It acts as an intermediate layer between raw data
    ingestion and business-level analytical processing.

    DATA TRANSFORMATION OBJECTIVES:
    1. Remove duplicate records.
    2. Handle NULL and missing values.
    3. Remove unwanted leading and trailing spaces.
    4. Standardize data formats and values.
    5. Maintain data consistency and quality.

    TABLE STRUCTURE:
    1. Order Information
    2. Customer Information
    3. Product Information
    4. Sales Information
    5. Data Warehouse Metadata

    WARNING:
    If the table already exists, this script will DROP it.
    ALL EXISTING DATA INSIDE THIS TABLE WILL BE LOST!

    Make sure to back up the data before execution if needed.

    ============================================================
*/

-- =============================================
-- STEP 1: SELECT THE DATABASE
-- =============================================

USE apexplanet;
GO

-- =============================================
-- STEP 2: CHECK AND DROP EXISTING TABLE
-- =============================================

IF OBJECT_ID(
    'silver.apexplanet_dataanalytics_dataset',
    'U'
) IS NOT NULL
BEGIN
    DROP TABLE silver.apexplanet_dataanalytics_dataset;

    PRINT 'Existing Silver layer table dropped successfully.';
END;
GO

-- =============================================
-- STEP 3: CREATE SILVER LAYER TABLE
-- =============================================

CREATE TABLE silver.apexplanet_dataanalytics_dataset
(
    -- Order Information
    order_id        VARCHAR(255),
    order_date      DATE,

    -- Customer Information
    customer_id     VARCHAR(255),
    customer_name   VARCHAR(255),
    age             INT,
    gender          VARCHAR(255),
    city            VARCHAR(255),

    -- Product Information
    product         VARCHAR(255),
    category        VARCHAR(255),

    -- Sales Information
    quantity        INT,
    unit_price      FLOAT,
    total_sales     FLOAT,

    -- Data Warehouse Metadata
    dwh_create_date DATETIME2 DEFAULT GETDATE()
);
GO

PRINT 'Silver layer table created successfully!';
GO

-- =============================================
-- STEP 4: VERIFY TABLE CREATION
-- =============================================

SELECT *
FROM silver.apexplanet_dataanalytics_dataset;
GO

-- =============================================
-- STEP 5: VERIFY TABLE STRUCTURE
-- =============================================

EXEC sp_help 'silver.apexplanet_dataanalytics_dataset';
GO
