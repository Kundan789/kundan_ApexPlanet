
/*
    ============================================================
              APEXPLANET - SILVER LAYER DATA LOADING
    ============================================================

    Description:
    This script extracts raw data from the Bronze layer,
    performs data cleaning and deduplication, and loads
    the transformed records into the Silver layer.

    Database      : apexplanet
    Source Table  : bronze.apexplanet_dataanalytics_dataset
    Target Table  : silver.apexplanet_dataanalytics_dataset

    TRANSFORMATION OPERATIONS:
    1. Remove leading and trailing spaces using TRIM().
    2. Replace NULL and blank city values with 'N/A'.
    3. Remove duplicate orders using ROW_NUMBER().
    4. Retain one record per order_id.
    5. Truncate existing Silver records before loading.
    6. Insert cleaned records into the Silver layer.

    WARNING:
    TRUNCATE TABLE permanently deletes ALL existing records
    from the Silver table before inserting fresh data.

    ============================================================
*/

-- =============================================
-- STEP 1: SELECT THE DATABASE
-- =============================================

USE apexplanet;
GO

-- =============================================
-- STEP 2: CHECK AND TRUNCATE EXISTING DATA
-- =============================================

IF OBJECT_ID(
    'silver.apexplanet_dataanalytics_dataset',
    'U'
) IS NOT NULL
BEGIN
    TRUNCATE TABLE silver.apexplanet_dataanalytics_dataset;

    PRINT 'Existing Silver layer data truncated successfully.';
END
ELSE
BEGIN
    PRINT 'ERROR: Silver layer destination table does not exist!';
    RETURN;
END;
GO

-- =============================================
-- STEP 3: INSERT CLEANED DATA INTO SILVER
-- =============================================

INSERT INTO silver.apexplanet_dataanalytics_dataset
(
    order_id,
    order_date,
    customer_id,
    customer_name,
    age,
    gender,
    city,
    product,
    category,
    quantity,
    unit_price,
    total_sales
)

SELECT
    -- Order Information
    TRIM(order_id) AS order_id,
    order_date,

    -- Customer Information
    TRIM(customer_id) AS customer_id,
    TRIM(customer_name) AS customer_name,
    age,
    TRIM(gender) AS gender,

    -- Handle NULL and Blank City Values
    COALESCE(NULLIF(TRIM(city), ''), 'N/A') AS city,

    -- Product Information
    TRIM(product) AS product,
    TRIM(category) AS category,

    -- Sales Information
    quantity,
    unit_price,
    total_sales

FROM
(
    -- Identify duplicate orders
    SELECT
        *,
        ROW_NUMBER() OVER
        (
            PARTITION BY order_id
            ORDER BY order_date
        ) AS rn

    FROM bronze.apexplanet_dataanalytics_dataset

) AS t

-- Retain only the first record for each order_id
WHERE rn = 1;
GO

PRINT 'Silver layer data loaded successfully!';
GO

-- =============================================
-- STEP 4: VERIFY LOADED DATA
-- =============================================

SELECT *
FROM silver.apexplanet_dataanalytics_dataset;
GO

-- =============================================
-- STEP 5: CHECK TOTAL RECORD COUNT
-- =============================================

SELECT
    COUNT(*) AS TotalRecordsLoaded
FROM silver.apexplanet_dataanalytics_dataset;
GO

